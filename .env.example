# =====================================================================
# Variáveis de ambiente da plataforma de cursos
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# A marca (nome, logo, cores, textos) NÃO fica aqui: é configurada pelo
# painel do administrador e gravada no banco.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Painel do Supabase > Project Settings > API (ou `npx supabase status` no local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave PÚBLICA (publishable / anon). Pode ir para o navegador: o acesso
# aos dados é protegido pela RLS no banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA (secret / service_role). Ignora a RLS: NUNCA exponha no
# navegador, nunca use prefixo NEXT_PUBLIC_ e não compartilhe.
SUPABASE_SECRET_KEY=

# --- Site -------------------------------------------------------------
# Endereço público da instalação, usado nos links dos e-mails.
# Ex.: https://cursos.govpar.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-mails (Resend) ---------------------------------------------------
# Chave de API do Resend (https://resend.com). Obrigatória em produção.
RESEND_API_KEY=

# Endereço remetente, num domínio verificado no Resend.
# Só o endereço: o nome exibido vem da marca. Ex.: nao-responda@govpar.com.br
EMAIL_REMETENTE=

# Opcional. "resend" (padrão quando RESEND_API_KEY existe) ou "arquivo"
# (desenvolvimento: grava os e-mails em .emails/ em vez de enviar).
EMAIL_TRANSPORTE=arquivo

# --- Só desenvolvimento -------------------------------------------------
# "1" faz o navegador falar com o Supabase local passando pelo próprio site
# (/supabase-local). Útil quando o site é aberto de outra máquina (prévia
# remota, celular na rede) e o navegador não alcança 127.0.0.1:54321.
# NUNCA use em produção.
NEXT_PUBLIC_SUPABASE_VIA_SITE=
