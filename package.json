    "criar-admin": "node --env-file-if-exists=.env.local scripts/criar-admin.ts",
    "seed:usuarios": "node --env-file-if-exists=.env.local scripts/seed-usuarios.ts",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/seed-usuarios.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
